# Ejemplo para desarrollo local con Docker: copia .env.docker.example a .env.docker
# y usa la URL real de CockroachDB junto con un JWT_SECRET aleatorio.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:26257/BASE_DE_DATOS?sslmode=verify-full
APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
BIND_ADDRESS=127.0.0.1
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO

# Opcionales: necesarios solo si se usa la integracion Microsoft OAuth.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
